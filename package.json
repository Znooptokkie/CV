{
  "dependencies": {
    "esbuild": "^0.27.3",
    "sass": "^1.97.2"
  },
  "name": "porto",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build:ts": "tsc",
    "build:sass": "sass sass/main.scss:static/css/main.css",
    "build": "esbuild ts/main.ts --bundle --minify --sourcemap --outfile=static/js/dist/main.js",
    "watch:ts": "esbuild ts/main.ts --bundle --sourcemap --outfile=static/js/dist/main.js --watch",
    "watch:sass": "sass --watch sass/main.scss:static/css/main.css",
    "watch:dev": "npm-run-all --parallel watch:ts watch:sass"
  },
  "keywords": [],
  "author": "Znooptokkie",
  "license": "ISC"
}
